{
  "$comment": "Effat Co. — master catalog taxonomy. Drives DB seed, URL slugs, faceted filters and JSON-LD. sale_mode: 'cart' = public price + checkout, 'quote' = spec page + RFQ button, 'hybrid' = price shown, quote for qty>threshold.",
  "version": "0.1.0",
  "currency": "EGP",
  "locales": ["ar", "en"],
  "default_locale": "ar",

  "attribute_library": {
    "brand":            { "type": "enum", "facet": true },
    "origin":           { "type": "enum", "facet": true, "values": ["مصري", "إيطالي", "ألماني", "صيني", "إسباني", "تركي"] },
    "cert":             { "type": "multi_enum", "facet": true, "values": ["الدفاع المدني", "EN3", "UL", "FM", "ISO 9001", "علامة الجودة المصرية", "CE", "NFPA"] },
    "capacity_kg":      { "type": "number", "unit": "kg", "facet": true },
    "capacity_l":       { "type": "number", "unit": "L", "facet": true },
    "agent_type":       { "type": "enum", "facet": true, "values": ["بودرة جافة", "ثاني أكسيد الكربون", "فوم", "ماء", "كيماوي رطب", "هالوترون", "FM200", "NOVEC 1230", "أيروسول"] },
    "fire_class":       { "type": "multi_enum", "facet": true, "values": ["A", "B", "C", "D", "F/K", "Electrical"] },
    "mounting":         { "type": "enum", "values": ["حائط", "أرضي", "عربة متحركة", "أوتوماتيك سقفي"] },
    "warranty_months":  { "type": "number" },
    "loop_type":        { "type": "enum", "facet": true, "values": ["تقليدي", "معنون", "لاسلكي"] },
    "zones":            { "type": "number", "facet": true },
    "resolution_mp":    { "type": "number", "unit": "MP", "facet": true },
    "camera_form":      { "type": "enum", "facet": true, "values": ["Dome", "Bullet", "PTZ", "Turret", "Fisheye", "Cube"] },
    "signal_type":      { "type": "enum", "facet": true, "values": ["IP/PoE", "HD-TVI", "AHD", "Analog"] },
    "ip_rating":        { "type": "enum", "facet": true, "values": ["IP54", "IP65", "IP66", "IP67", "IK10"] },
    "channels":         { "type": "number", "facet": true },
    "storage_tb":       { "type": "number", "unit": "TB" },
    "flow_gpm":         { "type": "number", "unit": "GPM", "facet": true },
    "head_m":           { "type": "number", "unit": "m" },
    "power_hp":         { "type": "number", "unit": "HP" },
    "diameter_inch":    { "type": "number", "unit": "\"", "facet": true },
    "size_apparel":     { "type": "enum", "facet": true, "values": ["S","M","L","XL","XXL"] },
    "shoe_size_eu":     { "type": "number", "facet": true },
    "color":            { "type": "enum", "facet": true },
    "material":         { "type": "enum", "facet": true },
    "refill_due_months":{ "type": "number", "$comment": "drives the maintenance-reminder engine" }
  },

